{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "agention",
      "include-component-in-tag": false,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "json",
          "path": "apps/server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/bridge/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/server'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/bridge'].version"
        },
        {
          "type": "json",
          "path": "apps/agent-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "out/claude-plugin/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "out/claude-plugin/.mcp.json",
          "jsonpath": "$.mcpServers.agention.args[1]"
        },
        {
          "type": "json",
          "path": "out/codex-plugin/.codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "out/codex-plugin/.mcp.json",
          "jsonpath": "$.mcpServers.agention.args[1]"
        },
        {
          "type": "generic",
          "path": "docs/operator-guide.md"
        }
      ]
    }
  }
}
