{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "agention",
      "component": "agention",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "exclude-paths": [
        "apps/bridge",
        "apps/agent-plugin",
        "out",
        ".claude-plugin",
        ".agents",
        "docs",
        "scripts",
        ".github"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "apps/server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/server'].version"
        }
      ]
    }
  }
}
