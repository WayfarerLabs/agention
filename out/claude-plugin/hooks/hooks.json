{
  "description": "Wakes the agent at its prompt when the Agention bridge finds the operator's messages.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/agention-watcher.sh\"",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/agention-watcher.sh\"",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
