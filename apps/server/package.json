{
  "name": "@wayfarerlabs/agention",
  "version": "0.8.0",
  "description": "The Agention server and operator CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayfarerLabs/agention.git",
    "directory": "apps/server"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agention": "dist/agention.js"
  },
  "files": [
    "dist",
    "web"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run --workspace=@wayfarerlabs/agention-web build && node build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.8",
    "@simplewebauthn/server": "14.1.0",
    "@wayfarerlabs/agention-api": "*",
    "@wayfarerlabs/agention-build": "*",
    "@wayfarerlabs/agention-private-files": "*",
    "ajv": "8.20.0",
    "hono": "4.13.19",
    "jose": "6.2.17"
  }
}
