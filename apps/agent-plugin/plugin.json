{
  "name": "agention",
  "version": "0.6.0",
  "description": "Connects agents to Agention, a self-hosted attention inbox: they start threads with their operator, ask what they need answered, and read the replies.",
  "author": {
    "name": "Wayfarer Labs"
  },
  "homepage": "https://github.com/WayfarerLabs/agention",
  "repository": "https://github.com/WayfarerLabs/agention",
  "license": "MIT",
  "keywords": [
    "agention",
    "attention",
    "inbox",
    "mcp"
  ],
  "mcpServer": {
    "name": "agention",
    "package": "@wayfarerlabs/agention-mcp",
    "environment": [
      "AGENTION_CONNECT",
      "AGENTION_HARNESS_PROFILE",
      "AGENTION_TMUX_SOCKET",
      "AGENTION_URL",
      "AGENTWORKS_AGENT",
      "AGENTWORKS_SESSION",
      "NODE_EXTRA_CA_CERTS"
    ],
    "toolTimeoutSeconds": 600
  }
}
